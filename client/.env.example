# =======================================================
# Collabry Frontend Environment Variables Example
# =======================================================

# Backend API URL (for local dev: http://localhost:5000, for prod: your backend URL e.g. https://collabry-api.up.railway.app)
VITE_API_URL=http://localhost:5000

# Google Client ID for OAuth login button
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
