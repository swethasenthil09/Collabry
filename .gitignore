# =======================================================
# Collabry Root .gitignore
# =======================================================

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production Build Outputs
dist/
dist-ssr/
client/dist/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
client/.env
client/.env.local
server/.env
server/.env.local

# Project Documentation & Internal System Notes
Collabry_Project_Documentation_v1.1.docx
*.docx
*.doc
extracted_doc.txt

# Uploads & Media Files (Include uploaded assets so production deploy has existing media)
# server/uploads/*


# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE Configs
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
Thumbs.db
Desktop.ini
